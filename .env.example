# --- Database ---
# Local dev: sqlite file. Production: swap provider in prisma/schema.prisma to postgresql
# and point this at Vercel Postgres / Supabase / Neon / Railway.
DATABASE_URL="file:./dev.db"

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated emails that get admin access (admin dashboard + unlimited credits)
ADMIN_EMAILS=""

# --- Google OAuth (optional) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (add your production URL too when you deploy). Leave blank to hide the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- OpenAI (chat + image generation: gpt-image-1 / DALL-E) ---
OPENAI_API_KEY="sk-..."

# --- PixVerse (video generation — all model versions with one key) ---
# Get a key at https://platform.pixverse.ai
PIXVERSE_API_KEY="sk-..."
PIXVERSE_API_BASE="https://app-api.pixverse.ai"
PIXVERSE_QUALITY="540p" # 360p | 540p | 720p | 1080p

# --- WaveSpeedAI (image models: Nano Banana, Seedream, Flux, Z-Image) ---
WAVESPEED_API_KEY=""

# --- Video providers: fill in whichever you actually sign up for ---
# Kling (via official API or an aggregator like WaveSpeedAI / fal.ai / PiAPI)
KLING_API_KEY=""
KLING_API_BASE="https://api.klingai.com" # verify current base URL in Kling's docs

# Runway
RUNWAY_API_KEY=""
RUNWAY_API_BASE="https://api.dev.runwayml.com"

# Google Veo (via Vertex AI)
GOOGLE_VERTEX_PROJECT_ID=""
GOOGLE_VERTEX_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="" # path to service account json, or use ADC

# Luma
LUMA_API_KEY=""
LUMA_API_BASE="https://api.lumalabs.ai"

# Pika
PIKA_API_KEY=""
PIKA_API_BASE="https://api.pika.art"

# --- Stripe (credits billing) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_100_CREDITS="price_..."
STRIPE_PRICE_500_CREDITS="price_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"
